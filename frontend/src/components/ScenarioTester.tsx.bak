export function ScenarioTester() {
  const navigate = useNavigate()
  const [selectedScenario, setSelectedScenario] = useState<Scenario | null>(null)
  const [loading, setLoading] = useState(false)
  
  async function runScenario(scenario: Scenario) {
    setLoading(true)
    try {
      const response = await api.post(`/api/v1/scenarios/${scenario.id}/run`)
      const job = response.data
      
      // Store job
      const stored = localStorage.getItem('crisismesh_jobs')
      const jobs: Job[] = stored ? JSON.parse(stored) : []
      jobs.unshift({
        job_id: job.job_id,
        status: job.status,
        started_at: job.started_at,
        trace_id: job.trace_id
      })
      localStorage.setItem('crisismesh_jobs', JSON.stringify(jobs))
      
      navigate(`/jobs/${job.job_id}`)
    } catch (error) {
      console.error('Failed to run scenario:', error)
      alert('Failed to run scenario. Check console for details.')
    } finally {
      setLoading(false)
    }
  }
  
  return (
    <div className="space-y-6">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-3xl font-bold text-slate-900">Disaster Scenarios</h1>
          <p className="text-slate-500 mt-1">10 verified failure archetypes from recent disasters - test CrisisMesh against real-world failures</p>
        </div>
        <div className="flex items-center gap-2 text-sm text-slate-500">
          <span className="flex items-center gap-1"><span className="w-2 h-2 rounded-full bg-crisis-500" /> Critical</span>
          <span className="flex items-center gap-1 ml-4"><span className="w-2 h-2 rounded-full bg-alert-500" /> High</span>
        </div>
      </div>
      
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {SCENARIOS.map((scenario) => (
          <div 
            key={scenario.id}
            className={`card p-6 hover:shadow-lg transition-shadow relative overflow-hidden ${selectedScenario?.id === scenario.id ? 'ring-2 ring-crisis-500' : ''}`}
            onClick={() => setSelectedScenario(scenario)}
          >
            <div className="absolute top-0 right-0 w-1 h-full bg-crisis-500" />
            <div className="flex items-start justify-between mb-4">
              <div className="flex-1 pr-4">
                <div className="flex items-center gap-2 mb-2">
                  <span className={`px-2 py-0.5 text-xs font-medium rounded ${getSeverityColor(scenario.severity)}`}>
                    {scenario.severity.toUpperCase()}
                  </span>
                  <span className="px-2 py-0.5 text-xs font-medium bg-slate-100 text-slate-600 rounded">
                    {scenario.disaster_type.replace('_', ' ').toUpperCase()}
                  </span>
                </div>
                <h3 className="font-semibold text-lg text-slate-900 mb-1">{scenario.name}</h3>
                <p className="text-sm text-slate-500">{scenario.failure_archetype}</p>
              </div>
            </div>
            
            <p className="text-sm text-slate-600 mb-4 line-clamp-3">{scenario.description}</p>
            
            <div className="pt-4 border-t border-slate-100">
              <p className="text-xs text-slate-500 mb-2">Expected Outcome:</p>
              <p className="text-sm text-slate-700 font-medium">{scenario.expected_outcome}</p>
            </div>
            
            <div className="mt-4 flex items-center justify-between">
              <button
                onClick={(e) => {
                  e.stopPropagation()
                  runScenario(scenario)
                }}
                disabled={loading}
                className={`w-full py-2 px-3 rounded-lg font-medium text-sm transition-colors flex items-center justify-center gap-2 ${
                  loading
                    ? 'bg-slate-200 text-slate-500 cursor-not-allowed'
                    : 'bg-crisis-600 text-white hover:bg-crisis-700'
                }`}
              >
                {loading ? (
                  <>
                    <Loader2 className="w-4 h-4 animate-spin" />
                    Running...
                  </>
                ) : (
                  <>
                    <Play className="w-4 h-4" />
                    Run Scenario
                  </>
                )}
              </button>
            </div>
          </div>
        ))}
      </div>
      
      {selectedScenario && (
        <div className="card p-6">
          <div className="flex items-center justify-between mb-4">
            <h2 className="text-xl font-semibold text-slate-900">Scenario Details</h2>
            <button onClick={() => setSelectedScenario(null)} className="text-slate-400 hover:text-slate-600">
              <ChevronLeft className="w-5 h-5" />
            </button>
          </div>
          
          <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <h3 className="font-medium text-slate-900 mb-3">Test Data</h3>
              <div className="space-y-4">
                {selectedScenario.test_data.sensor_readings && selectedScenario.test_data.sensor_readings.length > 0 && (
                  <div>
                    <h4 className="text-sm font-medium text-slate-700 mb-2">Sensor Readings ({selectedScenario.test_data.sensor_readings.length})</h4>
                    <div className="bg-slate-50 rounded-lg p-3 max-h-64 overflow-auto font-mono text-xs">
                      <pre>{JSON.stringify(selectedScenario.test_data.sensor_readings, null, 2)}</pre>
                    </div>
                  </div>
                )}
                {selectedScenario.test_data.social_media_posts && selectedScenario.test_data.social_media_posts.length > 0 && (
                  <div>
                    <h4 className="text-sm font-medium text-slate-700 mb-2">Social Media Posts ({selectedScenario.test_data.social_media_posts.length})</h4>
                    <div className="bg-slate-50 rounded-lg p-3 max-h-64 overflow-auto font-mono text-xs">
                      <pre>{JSON.stringify(selectedScenario.test_data.social_media_posts, null, 2)}</pre>
                    </div>
                  </div>
                )}
                {selectedScenario.test_data.official_alerts && selectedScenario.test_data.official_alerts.length > 0 && (
                  <div>
                    <h4 className="text-sm font-medium text-slate-700 mb-2">Official Alerts ({selectedScenario.test_data.official_alerts.length})</h4>
                    <div className="bg-slate-50 rounded-lg p-3 max-h-64 overflow-auto font-mono text-xs">
                      <pre>{JSON.stringify(selectedScenario.test_data.official_alerts, null, 2)}</pre>
                    </div>
                  </div>
                )}
              </div>
            </div>
            
            <div>
              <h3 className="font-medium text-slate-900 mb-3">Failure Archetype</h3>
              <p className="text-slate-600 mb-4">{selectedScenario.failure_archetype}</p>
              
              <h3 className="font-medium text-slate-900 mb-3">What CrisisMesh Solves</h3>
              <p className="text-slate-600 mb-4">{scenario.expected_outcome}</p>
              
              <h3 className="font-medium text-slate-900 mb-3">Sponsor Tech Mapping</h3>
              <div className="grid grid-cols-2 gap-2 text-sm">
                <div className="p-2 bg-blue-50 rounded"><span className="font-medium text-blue-700">Zetaris:</span> Data federation, schema registry</div>
                <div className="p-2 bg-purple-50 rounded"><span className="font-medium text-purple-700">Meterless:</span> H-Mem, Markovian, World Model</div>
                <div className="p-2 bg-green-50 rounded"><span className="font-medium text-green-700">NVIDIA:</span> GPU embeddings, CUDA acceleration</div>
                <div className="p-2 bg-orange-50 rounded"><span className="font-medium text-orange-700">Cursor:</span> AI-native dev environment</div>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  )
}