import { useState } from 'react'
import { useNavigate } from 'react-router-dom'
import { 
  Play, 
  Loader2, 
  CheckCircle, 
  XCircle,
  ChevronLeft,
} from 'lucide-react'
import api from '../lib/api'
import { getSeverityColor } from '../lib/utils'

interface Scenario {
  id: string
  name: string
  disaster_type: string
  severity: string
  failure_archetype: string
  description: string
  test_data: {
    sensor_readings?: any[]
    social_media_posts?: any[]
    official_alerts?: any[]
  }
  expected_outcome: string
}

interface Job {
  job_id: string
  status: string
  started_at: string
  completed_at?: string
  trace_id?: string
}

