        { post_id: 'tweet_2', platform: 'twitter', author: 'user456', content: 'My family stuck in collapsed building, Hatay province', timestamp: '2023-02-06T04:45:00Z', language: 'tr', location_mentioned: ['Hatay'], geocoded_location: [36.4, 36.2], urgency_keywords: ['stuck', 'collapsed', 'family'] }
      ],
