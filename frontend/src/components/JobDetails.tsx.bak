import { useState, useEffect } from 'react'
import { useParams, useNavigate } from 'react-router-dom'
import { 
  ChevronLeft, 
  Loader2, 
  CheckCircle, 
  XCircle, 
  AlertTriangle,
  Shield,
  Users,
  MapPin,
  Database,
  Brain,
  Network,
  FileText,
  Zap
} from 'lucide-react'
import { clsx } from 'clsx'
import api from '../lib/api'
import { cn, formatDate, getSeverityColor, getStatusColor } from '../lib/utils'

interface JobDetail {
  job_id: string
  status: string
  trace_id?: string
  final_output?: any
  agent_trace?: Record<string, any>
  started_at: string
  completed_at?: string
  input_files?: any[]
  disaster_context?: any
  quality_scores?: Record<string, number>
  validation_results?: any
  errors?: any[]
}

interface AgentStep {
  name: string
  status: 'completed' | 'running' | 'pending' | 'failed'
  duration?: number
  output_summary?: string
  error?: string
}

const AGENT_ORDER: AgentStep[] = [
  { name: 'PlannerAgent', status: 'pending' },
  { name: 'FormatDetector', status: 'pending' },
  { name: 'IngestionExecutor', status: 'pending' },
  { name: 'WorldModelSimulator', status: 'pending' },
  { name: 'MarkovianRouter', status: 'pending' },
  { name: 'HMemStore', status: 'pending' },
  { name: 'RiskDispatch', status: 'pending' },
  { name: 'EvaluatorAgent', status: 'pending' },
  { name: 'ReporterAgent', status: 'pending' },
]

const AGENT_ICONS: Record<string, any> = {
  PlannerAgent: Brain,
  FormatDetector: FileText,
  IngestionExecutor: Database,
  WorldModelSimulator: AlertTriangle,
  MarkovianRouter: Network,
  HMemStore: Shield,
  RiskDispatch: Users,
  EvaluatorAgent: CheckCircle,
  ReporterAgent: FileText,
}

export function JobDetails() {
  const { jobId } = useParams<{ jobId: string }>()
  const navigate = useNavigate()
  const [job, setJob] = useState<JobDetail | null>(null)
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState<string | null>(null)
  const [agentSteps, setAgentSteps] = useState<AgentStep[]>(AGENT_ORDER)
  const [activeTab, setActiveTab] = useState<'overview' | 'trace' | 'output' | 'quality'>('overview')
  
  useEffect(() => {
    if (jobId) {
      loadJobDetails()
    }
  }, [jobId])
  
  async function loadJobDetails() {
    setLoading(true)
    setError(null)
    try {
      const response = await api.get(`/api/v1/agent/convert/${jobId}`)
      const data = response.data
      setJob(data)
      
      // Update agent steps based on trace
      if (data.agent_trace) {
        const updatedSteps = AGENT_ORDER.map(step => {
          const trace = data.agent_trace![step.name]
          if (trace) {
            return {
              ...step,
              status: trace.error ? 'failed' : 'completed',
              duration: trace.duration,
              output_summary: trace.output_summary,
              error: trace.error
            }
          }
          // Check if any later agent has run
          const laterAgent = AGENT_ORDER.find(s => s.name === step.name)
          const laterIndex = AGENT_ORDER.indexOf(laterAgent!)
          const hasLaterCompleted = AGENT_ORDER.slice(laterIndex + 1).some(s => 
            data.agent_trace![s.name] && !data.agent_trace![s.name].error
          )
          return {
            ...step,
            status: hasLaterCompleted ? 'completed' : (laterIndex === AGENT_ORDER.findIndex(a => data.agent_trace![a.name]) ? 'running' : 'pending')
          }
        })
        setAgentSteps(updatedSteps)
      }
    } catch (err) {
      setError('Failed to load job details')
      console.error(err)
    } finally {
      setLoading(false)
    }
  }
  
  if (loading) {
    return (
      <div className="flex items-center justify-center h-64">
        <Loader2 className="w-8 h-8 text-crisis-600 animate-spin" />
      </div>
    )
  }
  
  if (error || !job) {
    return (
      <div className="card text-center py-12">
        <XCircle className="w-12 h-12 text-crisis-500 mx-auto mb-4" />
        <h3 className="text-lg font-medium text-slate-900 mb-2">Failed to load job</h3>
        <p className="text-slate-500 mb-4">{error || 'Job not found'}</p>
        <button onClick={() => navigate('/')} className="btn-primary">
          Back to Dashboard
        </button>
      </div>
    )
  }
  
  const isComplete = job.status === 'completed' || job.status === 'failed'
  const duration = job.completed_at 
    ? Math.round((new Date(job.completed_at).getTime() - new Date(job.started_at).getTime()) / 1000)
    : Math.round((Date.now() - new Date(job.started_at).getTime()) / 1000)
  
  return (
    <div className="space-y-6">
      {/* Header */}
      <div className="flex items-center justify-between">
        <div className="flex items-center gap-4">
          <button onClick={() => navigate('/')} className="p-2 hover:bg-slate-100 rounded-lg transition-colors">
            <ChevronLeft className="w-5 h-5 text-slate-600" />
          </button>
          <div>
            <h1 className="text-2xl font-bold text-slate-900">Job Details</h1>
            <p className="text-slate-500 text-sm font-mono">{job.job_id}</p>
          </div>
        </div>
        <div className="flex items-center gap-4">
          <span className={cn('px-3 py-1 rounded-full text-sm font-medium', getStatusColor(job.status))}>
            {job.status.toUpperCase()}
          </span>
          {job.disaster_context?.disaster_type && (
            <span className={cn('px-3 py-1 rounded-full text-sm font-medium', getSeverityColor(job.disaster_context.severity || 'medium'))}>
              {job.disaster_context.disaster_type.replace('_', ' ').toUpperCase()}
            </span>
          )}
        </div>
      </div>
      
      {/* Tabs */}
      <div className="border-b border-slate-200">
        <nav className="flex gap-1" role="tablist">
          {[
            { id: 'overview', label: 'Overview', icon: FileText },
            { id: 'trace', label: 'Agent Trace', icon: Network },
            { id: 'output', label: 'Output', icon: Database },
            { id: 'quality', label: 'Quality', icon: CheckCircle },
          ].map((tab) => (
            <button
              key={tab.id}
              role="tab"
              aria-selected={activeTab === tab.id}
              onClick={() => setActiveTab(tab.id as typeof activeTab)}
              className={cn(
                'flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-t-lg transition-colors border-b-2',
                activeTab === tab.id
                  ? 'border-crisis-500 text-crisis-600 bg-crisis-50'
                  : 'border-transparent text-slate-500 hover:text-slate-700 hover:bg-slate-50'
              )}
            >
              <tab.icon className="w-4 h-4" />
              {tab.label}
            </button>
          ))}
        </nav>
      </div>
      
      {/* Tab Content */}
      <div className="card">
        {activeTab === 'overview' && (
          <div className="p-6 space-y-6">
            <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div>
                <h3 className="text-sm font-medium text-slate-500 mb-2">Job Info</h3>
                <dl className="space-y-2 text-sm">
                  <div className="flex justify-between"><dt className="text-slate-500">Trace ID</dt><dd className="font-mono text-slate-900">{job.trace_id || 'N/A'}</dd></div>
                  <div className="flex justify-between"><dt className="text-slate-500">Started</dt><dd className="text-slate-900">{formatDate(job.started_at)}</dd></div>
                  <div className="flex justify-between"><dt className="text-slate-500">Completed</dt><dd className="text-slate-900">{job.completed_at ? formatDate(job.completed_at) : 'In progress'}</dd></div>
                  <div className="flex justify-between"><dt className="text-slate-500">Duration</dt><dd className="text-slate-900 font-mono">{duration}s</dd></div>
                  <div className="flex justify-between"><dt className="text-slate-500">Input Files</dt><dd className="text-slate-900">{job.input_files?.length || 0}</dd></div>
                </dl>
              </div>
              
              <div>
                <h3 className="text-sm font-medium text-slate-500 mb-2">Disaster Context</h3>
                <dl className="space-y-2 text-sm">
                  <div className="flex justify-between"><dt className="text-slate-500">Type</dt><dd className="text-slate-900 capitalize">{job.disaster_context?.disaster_type?.replace('_', ' ') || 'Unknown'}</dd></div>
                  <div className="flex justify-between"><dt className="text-slate-500">Severity</dt><dd className={cn('font-medium', getSeverityColor(job.disaster_context?.severity || 'medium'))}>{job.disaster_context?.severity || 'Unknown'}</dd></div>
                  <div className="flex justify-between"><dt className="text-slate-500">Location</dt><dd className="text-slate-900">{job.disaster_context?.location ? `${job.disaster_context.location[1].toFixed(2)}, ${job.disaster_context.location[0].toFixed(2)}` : 'Unknown'}</dd></div>
                  <div className="flex justify-between"><dt className="text-slate-500">Population at Risk</dt><dd className="text-slate-900">{job.disaster_context?.population_at_risk ? job.disaster_context.population_at_risk.toLocaleString() : 'Unknown'}</dd></div>
                </dl>
              </div>
              
              <div>
                <h3 className="text-sm font-medium text-slate-500 mb-2">Quality Summary</h3>
                <div className="space-y-2">
                  {job.quality_scores && Object.entries(job.quality_scores).map(([key, value]) => (
                    <div key={key} className="flex items-center justify-between">
                      <span className="text-sm text-slate-600 capitalize">{key.replace('_', ' ')}</span>
                      <div className="flex items-center gap-2">
                        <div className="w-24 h-2 bg-slate-200 rounded-full overflow-hidden">
                          <div 
                            className="h-full bg-crisis-500 transition-all" 
                            style={{ width: `${value * 100}%` }}
                          />
                        </div>
                        <span className="text-sm font-medium text-slate-900">{Math.round(value * 100)}%</span>
                      </div>
                    </div>
                  ))}
                  {(!job.quality_scores || Object.keys(job.quality_scores).length === 0) && (
                    <p className="text-sm text-slate-500">No quality scores available</p>
                  )}
                </div>
              </div>
            </div>
            
            {job.errors && job.errors.length > 0 && (
              <div className="p-4 bg-crisis-50 border border-crisis-200 rounded-lg">
                <h3 className="font-medium text-crisis-800 mb-2 flex items-center gap-2">
                  <AlertTriangle className="w-5 h-5" />
                  Errors ({job.errors.length})
                </h3>
                <ul className="space-y-1 text-sm text-crisis-700">
                  {job.errors.map((err, i) => (
                    <li key={i} className="font-mono">{err.agent}: {err.error}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}
        
        {activeTab === 'trace' && (
          <div className="p-6">
            <h3 className="text-sm font-medium text-slate-500 mb-4">Agent Execution Pipeline</h3>
            <div className="space-y-3">
              {agentSteps.map((step, index) => {
                const Icon = AGENT_ICONS[step.name] || Brain
                const isLast = index === agentSteps.length - 1
                return (
                  <div key={step.name} className="flex items-start gap-4">
                    <div className="flex flex-col items-center">
                      <div className={cn(
                        'w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0',
                        step.status === 'completed' ? 'bg-safe-100 text-safe-600' :
                        step.status === 'running' ? 'bg-crisis-100 text-crisis-600 animate-pulse' :
                        step.status === 'failed' ? 'bg-crisis-100 text-crisis-600' :
                        'bg-slate-100 text-slate-400'
                      )}>
                        <Icon className="w-5 h-5" />
                      </div>
                      {!isLast && (
                        <div className={cn(
                          'w-0.5 h-8 mt-1 flex-shrink-0',
                          step.status === 'completed' ? 'bg-safe-200' : 'bg-slate-200'
                        )} />
                      )}
                    </div>
                    <div className="flex-1 min-w-0">
                      <div className="flex items-center gap-2">
                        <h4 className="font-medium text-slate-900">{step.name}</h4>
                        {step.status === 'running' && <span className="px-2 py-0.5 text-xs bg-crisis-100 text-crisis-700 rounded">Running</span>}
                        {step.status === 'completed' && <span className="px-2 py-0.5 text-xs bg-safe-100 text-safe-700 rounded">Completed</span>}
                        {step.status === 'failed' && <span className="px-2 py-0.5 text-xs bg-crisis-100 text-crisis-700 rounded">Failed</span>}
                        {step.status === 'pending' && <span className="px-2 py-0.5 text-xs bg-slate-100 text-slate-500 rounded">Pending</span>}
                      </div>
                      {step.duration && (
                        <p className="text-xs text-slate-500 mt-1">Duration: {step.duration.toFixed(2)}s</p>
                      )}
                      {step.output_summary && (
                        <p className="text-xs text-slate-500 mt-1 font-mono">{step.output_summary}</p>
                      )}
                      {step.error && (
                        <p className="text-xs text-crisis-600 mt-1">Error: {step.error}</p>
                      )}
                    </div>
                  </div>
                )
              })}
            </div>
          </div>
        )}
        
        {activeTab === 'output' && (
          <div className="p-6">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-sm font-medium text-slate-500">Final Output</h3>
              <button className="btn-secondary text-sm">Download JSON</button>
            </div>
            <div className="bg-slate-50 rounded-lg p-4 max-h-96 overflow-auto font-mono text-xs">
              <pre>{JSON.stringify(job.final_output || { message: 'No output available' }, null, 2)}</pre>
            </div>
          </div>
        )}
        
        {activeTab === 'quality' && (
          <div className="p-6">
            <h3 className="text-sm font-medium text-slate-500 mb-4">Quality Validation Results</h3>
            {job.validation_results && Object.keys(job.validation_results).length > 0 ? (
              <div className="space-y-4">
                {Object.entries(job.validation_results).map(([key, value]) => (
                  <div key={key} className="p-4 bg-slate-50 rounded-lg">
                    <h4 className="font-medium text-slate-900 mb-2 capitalize">{key.replace('_', ' ')}</h4>
                    <div className="bg-white p-3 rounded border font-mono text-xs max-h-64 overflow-auto">
                      <pre>{JSON.stringify(value, null, 2)}</pre>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <p className="text-slate-500 text-center py-8">No validation results available</p>
            )}
          </div>
        )}
      </div>
    </div>
  )
}