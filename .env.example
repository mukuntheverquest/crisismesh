# CrisisMesh - Disaster Management Multi-Agent System
# Open Agent Hackathon 2026 - Track 1: Solving Fragmented Intelligence

# Application
APP_NAME=CrisisMesh
APP_VERSION=1.0.0
ENVIRONMENT=development
SAMPLE_MODE=true
DEBUG=true

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crisismesh
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crisismesh
SQLITE_URL=sqlite:///./data/crisismesh.db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Zetaris (Unified Data Layer)
ZETARIS_URL=http://localhost:8080
ZETARIS_API_KEY=your_zetaris_api_key_here
ZETARIS_ORG_ID=your_org_id
ZETARIS_WORKSPACE_ID=your_workspace_id

# Meterless (Observability)
METERLESS_API_URL=https://api.meterless.io
METERLESS_API_KEY=your_meterless_api_key_here
METERLESS_PROJECT_ID=your_project_id
METERLESS_ENVIRONMENT=development

# NVIDIA (GPU Acceleration)
NVIDIA_VISIBLE_DEVICES=0
CUDA_VISIBLE_DEVICES=0
NVIDIA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NVIDIA_LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
NVIDIA_TENSORRT_OPTIMIZATION=true
NVIDIA_BATCH_SIZE=32

# LLM Providers (for Planner/Evaluator agents)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1:8b

# External Data Sources
NWS_API_URL=https://api.weather.gov
USGS_API_URL=https://earthquake.usgs.gov/fdsnws/event/1
COPERNICUS_API_URL=https://catalogue.dataspace.copernicus.eu
HOTOSM_API_URL=https://api.hotosm.org
SENTINEL_HUB_API_URL=https://services.sentinel-hub.com

# Alert Systems
IPAWS_API_URL=https://api.ipaws.gov
ES_ALERT_API_URL=https://es-alert.example.com
GENSAS_API_URL=https://api.genasys.com

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Security
SECRET_KEY=your_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json